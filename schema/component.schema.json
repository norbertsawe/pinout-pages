{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pinout-cli component catalog (v2)",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {"pattern": "^[a-z0-9][a-z0-9_-]*$"},
  "additionalProperties": {"$ref": "#/$defs/component"},
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "pin": {
      "type": "object",
      "required": ["number", "name", "kind", "description"],
      "additionalProperties": false,
      "properties": {
        "number": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "integer"}]},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["power", "ground", "digital", "analog", "communication", "control", "nc"]},
        "description": {"type": "string", "minLength": 1},
        "functions": {"$ref": "#/$defs/strings"},
        "voltage": {"type": "string"},
        "notes": {"$ref": "#/$defs/strings"}
      }
    },
    "component": {
      "type": "object",
      "required": ["schema_version", "name", "description", "category", "package", "voltage", "pins", "layout", "sources"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 2},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "package": {"type": "string", "minLength": 1},
        "voltage": {"type": "string", "minLength": 1},
        "aliases": {"$ref": "#/$defs/strings"},
        "notes": {"$ref": "#/$defs/strings"},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "electrical": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "ascii_art": {"type": "string"},
        "pins": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pin"}},
        "layout": {
          "type": "object",
          "required": ["type", "orientation"],
          "additionalProperties": false,
          "properties": {
            "type": {"enum": ["dip", "dual", "header", "table"]},
            "orientation": {"type": "string", "minLength": 1},
            "rows": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": ["string", "null"]}}}
          },
          "allOf": [{"if": {"properties": {"type": {"enum": ["dual", "header"]}}}, "then": {"required": ["rows"]}}]
        }
      }
    }
  }
}
